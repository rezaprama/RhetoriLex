{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhetorilex.dev/schema/evidence-claim.v1.json",
  "type": "object",
  "required": ["id", "version", "evidence_order", "claim_strength_rules", "evidence_slot_names", "provenance", "policy"],
  "properties": {
    "id": {"const": "rhetorilex-evidence-claim-contract"},
    "version": {"type": "string"},
    "evidence_order": {"type": "array", "minItems": 5, "uniqueItems": true},
    "claim_strength_rules": {"type": "object"},
    "evidence_slot_names": {"type": "array", "minItems": 1, "uniqueItems": true},
    "provenance": {"type": "object"},
    "policy": {"type": "object"}
  }
}
